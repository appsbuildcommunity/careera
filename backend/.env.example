# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=careera_db

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth (see docs/AUTH_SETUP.md)
GOOGLE_CLIENT_ID=1234567890-abcdef.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret

# LLM Provider: mock | gemini | openai | anthropic | deepseek
LLM_PROVIDER=mock

# LLM Provider Options (see docs/LLM_INTEGRATION.md):
# - Gemini:    LLM_PROVIDER=gemini    | LLM_MODEL=gemini-1.5-flash | LLM_API_KEY=AIzaSy...
# - DeepSeek:  LLM_PROVIDER=deepseek  | LLM_MODEL=deepseek-chat   | LLM_API_KEY=sk-...     | LLM_URL=https://api.deepseek.com
# - OpenAI:    LLM_PROVIDER=openai    | LLM_MODEL=gpt-4o-mini      | LLM_API_KEY=sk-...
# - Anthropic: LLM_PROVIDER=anthropic | LLM_MODEL=claude-3-5-sonnet| LLM_API_KEY=sk-ant-...
LLM_API_KEY=
LLM_MODEL=
LLM_URL=

# CORS
ALLOWED_ORIGINS=http://localhost:3000
