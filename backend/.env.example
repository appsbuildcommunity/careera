# MongoDB
MONGODB_URI=mongodb://localhost:27017
DB_NAME=careera_db

# Security
SECRET_KEY=your-secret-key-here
ALGORITHM=HS256

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# LLM Provider (mock | gemini | openai | anthropic)
LLM_PROVIDER=mock

# Generic LLM credentials — shared by the active provider
LLM_API_KEY=
LLM_MODEL=

# CORS
ALLOWED_ORIGINS=http://localhost:3000
